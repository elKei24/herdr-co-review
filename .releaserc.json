{
  "branches": ["main"],
  "repositoryUrl": "git@github.com:elKei24/herdr-co-review.git",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      { "changelogFile": "CHANGELOG.md" }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash ci/prepare-release.sh ${nextRelease.version}",
        "successCmd": "printf 'released=true\\ntag=v%s\\n' \"${nextRelease.version}\" >> \"$GITHUB_OUTPUT\""
      }
    ],
    "@semantic-release/github",
    [
      "@semantic-release/git",
      {
        "assets": ["Cargo.toml", "Cargo.lock", "CHANGELOG.md", "herdr-plugin.toml"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
