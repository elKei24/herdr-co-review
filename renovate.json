{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "schedule:weekly"
  ],
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group all GitHub Actions bumps into one PR.",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group the semantic-release toolchain together.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["semantic-release", "/^@semantic-release//"],
      "groupName": "semantic-release"
    },
    {
      "description": "Auto-merge low-risk dev-tooling patch/minor updates.",
      "matchManagers": ["npm", "github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Keep Rust patch updates together; review minors manually.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "groupName": "cargo patch updates"
    }
  ]
}
